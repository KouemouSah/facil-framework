# =============================================================================
# Facil — Local Docker secrets template
# =============================================================================
# COPY this file to .env.secrets at the REPO ROOT (NOT in deploy/) and fill in
# the values. .env.secrets is gitignored and must NEVER be committed.
#
# Usage:
#   cp deploy/.env.secrets.example .env.secrets
#   $EDITOR .env.secrets
#   python deploy/providers/docker_local.py --config=deploy/config.yaml --apply
#
# These secrets are bound into the backend + db-init containers via the
# `env_file: ./.env.secrets` directive in docker-compose.local.yml.
#
# Generation tips for the random secrets below:
#   openssl rand -hex 32                          # JWT_SECRET_KEY, SECRET_KEY, etc.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                                  # TOTP_ENCRYPTION_KEY (Fernet base64)
# =============================================================================

# --- REQUIRED for the app to boot ----------------------------------------------

# JWT signing key (HS256). Random 32+ bytes hex.
JWT_SECRET_KEY=replace-me-with-openssl-rand-hex-32

# FastAPI session signing. Random 32+ bytes hex. Can reuse JWT_SECRET_KEY.
SECRET_KEY=replace-me-with-openssl-rand-hex-32

# Fernet base64-encoded key for 2FA TOTP secret encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-me-with-fernet-base64-key

# Bearer token used to authenticate /cron/* endpoints. Random opaque string.
CRON_SECRET=replace-me-with-random-token

# Google AI Studio API key (or leave empty if using Vertex AI ADC).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- REQUIRED if those subsystems are enabled ----------------------------------

# Firebase Admin SDK service account JSON. Paste the FULL JSON on one line:
#   {"type":"service_account","project_id":"...","private_key":"-----BEGIN..."}
# Leave empty if Firebase push notifications + Storage are not used locally.
FIREBASE_SERVICE_ACCOUNT_TAXASGE_DEV=

# HMAC key for QR receipt token signing. Random 32+ bytes hex.
# Falls back to JWT_SECRET_KEY at runtime if not set.
RECEIPT_VERIFICATION_SECRET=

# --- OPTIONAL (mostly observability + niceties) --------------------------------

# Supabase legacy bridge (only if some app code reads SUPABASE_*).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sentry DSN (backend project). Leave empty to disable Sentry.
SENTRY_DSN=

# Grafana Cloud OTLP token (for traces + metrics). Leave empty to disable.
GRAFANA_SA_TOKEN=

# MaxMind GeoLite2 license key — auto-downloads the GeoIP DB at boot.
# Sign up free at https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# SMTP credentials for outbound email. Leave empty to disable email.
SMTP_PASSWORD=

# --- POSTGRES PASSWORD (Compose-level only) ------------------------------------
# Override the default 'localdev' password baked into postgres + DATABASE_URL.
# Note: this is read by docker-compose interpolation, not by the backend.
# POSTGRES_PASSWORD=localdev

# =============================================================================
# After filling this in:
#   python deploy/providers/docker_local.py --validate    # check prereqs
#   python deploy/providers/docker_local.py --plan        # preview compose
#   python deploy/providers/docker_local.py --apply       # bring it up
#
# Logs: python deploy/providers/docker_local.py --logs
# Stop: python deploy/providers/docker_local.py --down
# Wipe: python deploy/providers/docker_local.py --down --volumes
# =============================================================================
