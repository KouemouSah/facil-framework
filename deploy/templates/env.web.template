# =============================================================================
# Facil — Frontend (Next.js) .env (generated from deploy/config.yaml)
# =============================================================================
# DO NOT EDIT THIS FILE MANUALLY.
# Edit deploy/config.yaml and re-run:
#     python deploy/scripts/render_env.py --target=web
#
# All NEXT_PUBLIC_* values are baked into the client bundle at build time.
# SENTRY_AUTH_TOKEN is build-time only and comes from secrets manifest.
# =============================================================================

NEXT_PUBLIC_API_URL={{server.api_base_url}}
NEXT_PUBLIC_SITE_URL={{server.frontend_url}}
NEXT_PUBLIC_ENVIRONMENT={{meta.environment}}
NEXT_PUBLIC_BUILD_VERSION={{meta.version}}
# NEXT_PUBLIC_SENTRY_DSN and NEXT_PUBLIC_LOGROCKET_APP_ID are bound at
# build time by the provider script via Cloud Build substitutions
# (see secrets-manifest.json for the mapping).
