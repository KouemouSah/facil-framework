# =============================================================================
# Facil — Backend .env (generated from deploy/config.yaml)
# =============================================================================
# DO NOT EDIT THIS FILE MANUALLY.
# Edit deploy/config.yaml and re-run:
#     python deploy/scripts/render_env.py --target=backend
#
# Secrets are NOT in this file. They are bound at runtime by the provider
# (Cloud Run --set-secrets, Docker Compose secrets, etc.) using the mapping
# in deploy/.secrets-manifest.json.
# =============================================================================

# --- Application ---
ENVIRONMENT={{meta.environment}}
DEBUG=false
API_HOST={{server.api_host}}
PORT={{server.port}}
FRONTEND_URL={{server.frontend_url}}
API_BASE_URL={{server.api_base_url}}
MOBILE_DEEP_LINK_SCHEMES={{server.mobile_deep_link_schemes}}
LOG_LEVEL={{server.log_level}}
ENABLE_STRUCTURED_LOGGING={{features.structured_logging}}

# --- Database (URL/credentials come from secrets manifest) ---
DB_POOL_SIZE={{database.pool.min_connections}}
DB_MAX_OVERFLOW={{database.pool.max_connections}}
DB_POOL_TIMEOUT={{database.pool.pool_timeout_seconds}}
DATABASE_MIN_CONNECTIONS={{database.pool.min_connections}}
DATABASE_MAX_CONNECTIONS={{database.pool.max_connections}}

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES={{auth.access_token_minutes}}
REFRESH_TOKEN_EXPIRE_DAYS={{auth.refresh_token_days}}
# JWT_SECRET_KEY, SECRET_KEY, TOTP_ENCRYPTION_KEY: from secrets manifest

# --- Firebase ---
FIREBASE_PROJECT_ID={{firebase.project_id}}
FIREBASE_STORAGE_BUCKET={{firebase.storage_bucket}}
FIREBASE_ANDROID_APP_ID={{firebase.android_app_id}}

# --- AI / Gemini ---
GOOGLE_CLOUD_PROJECT={{ai.google_cloud_project}}
GOOGLE_CLOUD_LOCATION={{ai.google_cloud_location}}
GEMINI_CHAT_MODEL={{ai.models.chat}}
GEMINI_PRO_MODEL={{ai.models.pro}}
GEMINI_EMBEDDING_MODEL={{ai.models.embedding}}
GEMINI_MAX_OUTPUT_TOKENS={{ai.generation.max_output_tokens}}
GEMINI_TEMPERATURE={{ai.generation.temperature}}
GEMINI_TOP_P={{ai.generation.top_p}}
GEMINI_TOP_K={{ai.generation.top_k}}

# --- Payments — BANGE ---
BANGE_API_URL={{payments.bange.api_url}}
BANGE_MERCHANT_ID={{payments.bange.merchant_id}}

# --- Payments — ECOBANK ---
ECOBANK_API_URL={{payments.ecobank.api_url}}
ECOBANK_CLIENT_ID={{payments.ecobank.client_id}}
ECOBANK_PRIMARY_METHODS={{payments.ecobank.primary_methods}}

# --- Payments — MPGS ---
MPGS_API_URL={{payments.mpgs.api_url}}
MPGS_MERCHANT_ID={{payments.mpgs.merchant_id}}
MPGS_API_VERSION={{payments.mpgs.api_version}}
MPGS_PRIMARY_METHODS={{payments.mpgs.primary_methods}}

# --- SMTP ---
SMTP_HOST={{smtp.host}}
SMTP_PORT={{smtp.port}}
SMTP_USERNAME={{smtp.username}}
SMTP_USE_TLS={{smtp.use_tls}}
SMTP_FROM_EMAIL={{smtp.from_email}}
SMTP_FROM_NAME={{smtp.from_name}}

# --- Observability (optional — DSN, tokens, GeoIP key from secrets manifest) ---
GRAFANA_OTLP_ENDPOINT={{observability.grafana_otlp_endpoint}}
SLACK_WEBHOOK_URL={{observability.slack_webhook_url}}

# --- Cache / Rate limiting ---
CACHE_TTL={{redis.cache_ttl_seconds}}
RATE_LIMIT_ENABLED={{features.rate_limit_enabled}}

# --- Feature flags ---
SCHEDULER_ENABLED={{features.scheduler_enabled}}
ENABLE_METRICS={{features.metrics_enabled}}
FEATURE_EXECUTIVE_TOOLS={{features.executive_tools}}
FEATURE_LLM_ROUTING_ENABLED={{features.llm_routing}}
PENALTIES_ENABLED={{features.penalties}}

# --- Legal ---
LEGAL_PRIVACY_VERSION={{legal.privacy_version}}
LEGAL_PRIVACY_LAST_UPDATED={{legal.privacy_last_updated}}
LEGAL_TERMS_VERSION={{legal.terms_version}}
LEGAL_TERMS_LAST_UPDATED={{legal.terms_last_updated}}
LEGAL_COOKIES_VERSION={{legal.cookies_version}}
LEGAL_COOKIES_LAST_UPDATED={{legal.cookies_last_updated}}

# --- Advanced overrides (TUNABLES from config.yaml's env_overrides:) ---
# Appended automatically by render_env.py. Do not edit below this line.
{{__env_overrides__}}
