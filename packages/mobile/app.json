{
  "expo": {
    "name": "Facil",
    "slug": "facil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_facil.png",
    "scheme": "facil",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taxasge.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Facil necesita acceso a la cámara para escanear documentos",
        "NSPhotoLibraryUsageDescription": "Facil necesita acceso a las fotos para adjuntar documentos",
        "NSFaceIDUsageDescription": "Facil utiliza Face ID para un acceso rápido y seguro",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.taxasge.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon_facil.png"
      },
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_hd.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#1565C0",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Facil"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 25,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraMavenRepos": [
              "https://storage.googleapis.com/logrocket-maven/"
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "taxasge",
          "project": "react-native"
        }
      ],
      "./plugins/with-adi-registration"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "14918b5d-b6e3-4e37-8860-a92d090dd247"
      }
    },
    "owner": "emacsah"
  }
}
