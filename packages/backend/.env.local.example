# =============================================================================
# TaxasGE Backend - Local Development Environment Variables
# =============================================================================
# ⚠️  DO NOT COMMIT THIS FILE WITH REAL VALUES
# ⚠️  Copy to .env.local and fill in your credentials
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENV=local
NODE_ENV=development
DEBUG_MODE=true

# =============================================================================
# DATABASE (PostgreSQL Supabase)
# =============================================================================
# Get from: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-jwt

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# In production, these are loaded from Google Cloud Secret Manager
# For local dev, you can set them here (will fallback if Secret Manager unavailable)

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=your-local-dev-jwt-secret-change-me

# =============================================================================
# EMAIL SERVICE (Gmail)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_USE_TLS=True

# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate app password for "Mail"
# 3. Copy 16-character password here

# =============================================================================
# REDIS CACHE (Optional)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# FIREBASE
# =============================================================================
FIREBASE_PROJECT_ID=taxasge-dev
FIREBASE_STORAGE_BUCKET=taxasge-dev.firebasestorage.app

# Service Account JSON files (local paths)
# In production, these are stored in Secret Manager
FIREBASE_SERVICE_ACCOUNT_DEV=./config/taxasge-dev-firebase-adminsdk.json

# =============================================================================
# API RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# EXTERNAL SERVICES (Future Integration)
# =============================================================================

# Bange Payment Gateway
# BANGE_API_URL=https://api.bange.com
# BANGE_API_KEY=your-bange-api-key
# BANGE_MERCHANT_ID=your-merchant-id

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=development

# Slack Notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_AI_CHATBOT=true
ENABLE_OFFLINE_MODE=true
ENABLE_BIOMETRIC_AUTH=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_CRASH_REPORTING=false
ENABLE_ANALYTICS=false

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================
AI_MODEL_PATH=assets/ml/taxasge_model.tflite
AI_TOKENIZER_PATH=assets/ml/tokenizer.json
AI_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env.local
# 2. Fill in your actual credentials
# 3. NEVER commit .env.local to git (it's in .gitignore)
# 4. In production, secrets are loaded from Google Cloud Secret Manager
# 5. This file is only for local development convenience
