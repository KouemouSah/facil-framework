{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_id": "PASAPORTE_GQ_V1",
  "version": "1.0",
  "title": "Pasaporte Biometrico - Guinea Ecuatorial",
  "description": "Schema d'extraction pour le Passeport biometrique de Guinee Equatoriale",
  "document_type": "PASAPORTE",
  "country": "GQ",
  "faces": ["data_page"],

  "extraction": {
    "documento": {
      "description": "Informations du document",
      "fields": {
        "tipo_documento": {
          "type": "string",
          "enum": ["P", "S", "D"],
          "required": true,
          "description": "Type de passeport: P=Ordinario, S=Servicio, D=Diplomatico",
          "field_label": "Type/Tipo",
          "source": "data_page"
        },
        "codigo_pais": {
          "type": "string",
          "const": "GNQ",
          "required": true,
          "description": "Code pays ISO (GNQ pour Guinea Ecuatorial)",
          "field_label": "Code/Codigo",
          "source": "data_page"
        },
        "numero_pasaporte": {
          "type": "string",
          "required": true,
          "pattern": "^[A-Z]{2}[0-9]{6,7}$",
          "description": "Numero de pasaporte (ex: AA001696)",
          "field_label": "Passport No./No. Pasaporte",
          "source": "data_page",
          "pii": true,
          "encrypt": true
        },
        "fecha_expedicion": {
          "type": "string",
          "format": "date",
          "required": true,
          "description": "Date of issue / Fecha de expedicion",
          "field_label": "Date of issue/Fecha de expedición",
          "source": "data_page",
          "date_format": "DD MMM YY"
        },
        "fecha_expiracion": {
          "type": "string",
          "format": "date",
          "required": true,
          "description": "Date of expiry / Fecha de expiracion",
          "field_label": "Date of expiry/Fecha de caducidad",
          "source": "data_page",
          "date_format": "DD MMM YY",
          "validation": {
            "rule": "check_expiry",
            "warning_months": 6,
            "error": "Pasaporte expirado o por expirar"
          }
        },
        "autoridad_emisora": {
          "type": "string",
          "required": false,
          "description": "Authority / Autoridad emisora",
          "field_label": "Authority/Autoridad",
          "source": "data_page"
        }
      }
    },

    "titular": {
      "description": "Informations du titulaire",
      "fields": {
        "apellidos": {
          "type": "string",
          "required": true,
          "description": "Surname / Apellido(s)",
          "field_label": "Surname/Apellidos",
          "source": "data_page",
          "pii": true
        },
        "nombres": {
          "type": "string",
          "required": true,
          "description": "Given names / Nombre(s)",
          "field_label": "Given names/Nombres",
          "source": "data_page",
          "pii": true
        },
        "sexo": {
          "type": "string",
          "enum": ["M", "F"],
          "required": true,
          "description": "Sex / Sexo: M=Male/Masculino, F=Female/Femenino",
          "field_label": "Sex/Sexo",
          "source": "data_page"
        },
        "nacionalidad": {
          "type": "string",
          "required": true,
          "default": "ECUATOGUINEANA",
          "description": "Nationality / Nacionalidad",
          "field_label": "Nationality/Nacionalidad",
          "source": "data_page"
        },
        "fecha_nacimiento": {
          "type": "string",
          "format": "date",
          "required": true,
          "description": "Date of birth / Fecha de nacimiento",
          "field_label": "Date of birth/Fecha de nacimiento",
          "source": "data_page",
          "date_format": "DD MMM YY",
          "pii": true
        },
        "lugar_nacimiento": {
          "type": "string",
          "required": true,
          "description": "Place of birth / Lugar de nacimiento",
          "field_label": "Place of birth/Lugar de nacimiento",
          "source": "data_page"
        },
        "profesion": {
          "type": "string",
          "required": false,
          "description": "Profession / Profesion del titular",
          "field_label": "Profession/Profesión",
          "source": "data_page"
        },
        "numero_dip": {
          "type": "string",
          "required": false,
          "pattern": "^[0-9]{9}$",
          "description": "Personal No. / No. D.I.P. (numero DIP associe)",
          "field_label": "Personal No./No. D.I.P.",
          "source": "data_page",
          "pii": true
        }
      }
    },

    "mrz": {
      "description": "Zone MRZ (Machine Readable Zone) - 2 lignes TD3",
      "format": "TD3",
      "lines": 2,
      "chars_per_line": 44,
      "source": "data_page",
      "fields": {
        "linea_1": {
          "type": "string",
          "required": true,
          "pattern": "^P[<A-Z][A-Z]{3}[A-Z<]{39}$",
          "length": 44,
          "description": "Premiere ligne MRZ: P< + pays + nom<<prenoms",
          "structure": {
            "position_1": "P (Passeport)",
            "position_2": "< ou type (S/D)",
            "positions_3_5": "GNQ (pays)",
            "positions_6_44": "APELLIDO<<NOMBRES<<<<..."
          },
          "example": "P<GNQESONO<EBALE<<RAMON<NZE<<<<<<<<<<<<<<<<<<"
        },
        "linea_2": {
          "type": "string",
          "required": true,
          "pattern": "^[A-Z0-9<]{9}[0-9][A-Z]{3}[0-9]{7}[MF<][0-9]{7}[A-Z0-9<]{14}[0-9]{2}$",
          "length": 44,
          "description": "Deuxieme ligne MRZ: numero + check + pays + fecha_nac + check + sexo + fecha_exp + check + optionnel + check_final",
          "structure": {
            "positions_1_9": "Numero pasaporte",
            "position_10": "Check digit numero",
            "positions_11_13": "Nationalite (GNQ)",
            "positions_14_19": "Fecha nacimiento (YYMMDD)",
            "position_20": "Check digit fecha nac",
            "position_21": "Sexo (M/F/<)",
            "positions_22_27": "Fecha expiracion (YYMMDD)",
            "position_28": "Check digit fecha exp",
            "positions_29_42": "Donnees optionnelles",
            "position_43": "Check digit optionnel",
            "position_44": "Check digit composite"
          },
          "example": "AA0016965GNQ7711225M2305088<<<<<<<<<<<<<<B1"
        }
      }
    }
  },

  "validations": [
    {
      "id": "pasaporte_not_expired",
      "rule": "fecha_expiracion > TODAY",
      "error_es": "Pasaporte expirado",
      "error_fr": "Passeport expire",
      "severity": "error"
    },
    {
      "id": "pasaporte_expiring_soon",
      "rule": "fecha_expiracion > TODAY + 6 MONTHS",
      "error_es": "Pasaporte expira en menos de 6 meses",
      "error_fr": "Passeport expire dans moins de 6 mois",
      "severity": "warning"
    },
    {
      "id": "mrz_apellido_match",
      "rule": "mrz.linea_1 CONTAINS titular.apellidos",
      "error_es": "MRZ no coincide con apellido",
      "error_fr": "MRZ ne correspond pas au nom",
      "severity": "error"
    },
    {
      "id": "mrz_numero_match",
      "rule": "documento.numero_pasaporte IN mrz.linea_2[0:9]",
      "error_es": "Numero pasaporte no coincide con MRZ",
      "error_fr": "Numero passeport ne correspond pas au MRZ",
      "severity": "error"
    },
    {
      "id": "mrz_sexo_match",
      "rule": "titular.sexo == mrz.linea_2[20]",
      "error_es": "Sexo no coincide con MRZ",
      "error_fr": "Sexe ne correspond pas au MRZ",
      "severity": "error"
    },
    {
      "id": "mrz_checksum_valid",
      "rule": "validate_mrz_checksums(mrz)",
      "error_es": "Checksum MRZ invalido",
      "error_fr": "Checksum MRZ invalide",
      "severity": "error"
    }
  ],

  "gemini_hints": {
    "document_description": "Pasaporte biometrico de Guinea Ecuatorial - documento de viaje oficial",
    "language": "es/en bilingue",
    "date_format": "DD MMM YY (ex: 09 MAY 18)",
    "visual_zones": [
      "En-tete: REPUBLICA DE GUINEA ECUATORIAL / REPUBLIC OF EQUATORIAL GUINEA",
      "Zone superieure: Ecusson national",
      "Zone gauche: Photo du titulaire + Signature",
      "Zone centrale-droite: Donnees textuelles bilingues",
      "Zone inferieure: MRZ (2 lignes de 44 caracteres)"
    ],
    "field_layout": {
      "left_column": ["Photo", "Signature"],
      "right_column": [
        "Type/Tipo",
        "Code/Codigo",
        "Passport No./No. Pasaporte",
        "Surname/Apellidos",
        "Given names/Nombres",
        "Nationality/Nacionalidad",
        "Date of birth/Fecha de nacimiento",
        "Sex/Sexo",
        "Place of birth/Lugar de nacimiento",
        "Date of issue/Fecha de expedicion",
        "Date of expiry/Fecha de caducidad",
        "Authority/Autoridad",
        "Profession/Profesion",
        "Personal No./No. D.I.P."
      ]
    },
    "mrz_format": "TD3 (passeport standard OACI)",
    "ocr_challenges": [
      "Reflets sur page plastifiee",
      "Photo de mauvaise qualite du document",
      "Page pliee ou endommagee",
      "MRZ partiellement visible",
      "Dates au format DD MMM YY (avec mois en lettres)"
    ],
    "month_mapping": {
      "JAN": "01", "FEB": "02", "MAR": "03", "APR": "04",
      "MAY": "05", "JUN": "06", "JUL": "07", "AUG": "08",
      "SEP": "09", "OCT": "10", "NOV": "11", "DEC": "12",
      "ENE": "01", "ABR": "04", "AGO": "08", "DIC": "12"
    }
  },

  "tesseract_patterns": {
    "numero_pasaporte": [
      "(?:PASSPORT\\s*NO|NO\\.?\\s*PASAPORTE)\\s*[.:#]?\\s*([A-Z]{2}[0-9]{6,7})",
      "^([A-Z]{2}[0-9]{6,7})$"
    ],
    "apellidos": [
      "(?:SURNAME|APELLIDOS?)\\s*[/#:]?\\s*([A-Z\\s]+)",
      "1\\.?\\s*([A-Z]{2,}(?:\\s+[A-Z]+)*)"
    ],
    "nombres": [
      "(?:GIVEN\\s*NAMES?|NOMBRES?)\\s*[/#:]?\\s*([A-Z\\s]+)",
      "2\\.?\\s*([A-Z][a-zA-Z]+(?:\\s+[A-Z][a-zA-Z]+)*)"
    ],
    "fecha_nacimiento": [
      "(?:DATE\\s*OF\\s*BIRTH|FECHA\\s*(?:DE\\s*)?NACIMIENTO)\\s*[/#:]?\\s*(\\d{2}\\s*[A-Z]{3}\\s*\\d{2})",
      "(?:DOB|F\\.?\\s*NAC)\\s*[/#:]?\\s*(\\d{2}[/-]\\d{2}[/-]\\d{2,4})"
    ],
    "fecha_expedicion": [
      "(?:DATE\\s*OF\\s*ISSUE|FECHA\\s*(?:DE\\s*)?EXPEDICI[OÓ]N)\\s*[/#:]?\\s*(\\d{2}\\s*[A-Z]{3}\\s*\\d{2})",
      "(?:ISSUED|EXPEDIDO)\\s*[/#:]?\\s*(\\d{2}[/-]\\d{2}[/-]\\d{2,4})"
    ],
    "fecha_expiracion": [
      "(?:DATE\\s*OF\\s*EXPIRY|FECHA\\s*(?:DE\\s*)?(?:CADUCIDAD|EXPIRACI[OÓ]N))\\s*[/#:]?\\s*(\\d{2}\\s*[A-Z]{3}\\s*\\d{2})",
      "(?:EXPIRY|VALID\\s*UNTIL|CADUCA)\\s*[/#:]?\\s*(\\d{2}[/-]\\d{2}[/-]\\d{2,4})"
    ],
    "lugar_nacimiento": [
      "(?:PLACE\\s*OF\\s*BIRTH|LUGAR\\s*(?:DE\\s*)?NACIMIENTO)\\s*[/#:]?\\s*([A-Z][A-Za-z\\s-]+)"
    ],
    "sexo": [
      "(?:SEX|SEXO)\\s*[/#:]?\\s*([MF])",
      "\\b([MF])\\b"
    ],
    "numero_dip": [
      "(?:PERSONAL\\s*NO|NO\\.?\\s*D\\.?I\\.?P\\.?)\\s*[/#:]?\\s*([0-9]{9})"
    ],
    "tipo_documento": [
      "(?:TYPE|TIPO)\\s*[/#:]?\\s*([PSD])"
    ]
  },

  "mrz_parsing": {
    "line_1": {
      "document_type": {"start": 0, "end": 2, "description": "P< ou PS ou PD"},
      "country_code": {"start": 2, "end": 5, "expected": "GNQ"},
      "names": {"start": 5, "end": 44, "separator": "<<", "description": "APELLIDO<<NOMBRES"}
    },
    "line_2": {
      "passport_number": {"start": 0, "end": 9},
      "check_digit_1": {"start": 9, "end": 10},
      "nationality": {"start": 10, "end": 13, "expected": "GNQ"},
      "birth_date": {"start": 13, "end": 19, "format": "YYMMDD"},
      "check_digit_2": {"start": 19, "end": 20},
      "sex": {"start": 20, "end": 21, "values": ["M", "F", "<"]},
      "expiry_date": {"start": 21, "end": 27, "format": "YYMMDD"},
      "check_digit_3": {"start": 27, "end": 28},
      "optional_data": {"start": 28, "end": 42},
      "check_digit_4": {"start": 42, "end": 43},
      "composite_check": {"start": 43, "end": 44}
    }
  }
}
