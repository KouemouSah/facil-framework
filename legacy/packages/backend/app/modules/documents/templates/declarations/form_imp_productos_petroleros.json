{
  "name": "imp_productos_petroleros",
  "category": "petroleum_products_tax",
  "description": "Impuesto sobre Productos Pétroliferos - IVS y FMI",
  "version": "1.0",
  "fields": [
    {"id": "nif", "label": ["N.I.F."], "type": "text", "pattern": "\\d{8}[A-Z]", "required": true},
