    {"id": "ejercicio", "label": ["Ejercicio"], "type": "year", "required": true},
    {"id": "periodo", "label": ["Periodo"], "type": "text", "required": true},
    {"id": "fecha", "label": ["Fecha"], "type": "date", "required": true},
    {"id": "prod_sujetos_precio", "label": ["01 Precio"], "type": "currency", "required": true},
    {"id": "prod_sujetos_cuota", "label": ["02 Cuota"], "type": "currency", "required": true},
    {"id": "prod_sujetos_total", "label": ["03 Total Devengado"], "type": "currency", "required": true},
