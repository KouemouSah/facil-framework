# ============================================================================
# TaxasGE Frontend - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_APP_NAME=TaxasGE
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API URL (Cloud Run service) - canonical variable used by GitHub Actions
NEXT_PUBLIC_API_URL=https://taxasge-backend-dev.run.app
NEXT_PUBLIC_API_VERSION=v1

# Frontend URL (this service on Cloud Run)
NEXT_PUBLIC_SITE_URL=https://taxasge-frontend-dev.run.app

# API Timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================================================
# FEATURES FLAGS
# ============================================================================
NEXT_PUBLIC_ENABLE_PWA=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SEO=true
NEXT_PUBLIC_ENABLE_I18N=true
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_CHATBOT=true

# ============================================================================
# INTERNATIONALIZATION
# ============================================================================
NEXT_PUBLIC_DEFAULT_LANGUAGE=es
NEXT_PUBLIC_SUPPORTED_LANGUAGES=es,fr,en

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=

# LogRocket (Session Replay + Diagnostics)
# App ID format: <org>/<project>. Leave empty in dev/local to skip init entirely.
# Init also auto-skips when NODE_ENV === 'development'.
NEXT_PUBLIC_LOGROCKET_APP_ID=0eqns2/facil

# Build version stamp surfaced to LogRocket as `release`. CI overrides at build time.
NEXT_PUBLIC_BUILD_VERSION=dev

# ============================================================================
# SEO
# ============================================================================
NEXT_PUBLIC_SITE_NAME=TaxasGE
NEXT_PUBLIC_SITE_DESCRIPTION=Plataforma digital de gestión fiscal de Guinea Ecuatorial
NEXT_PUBLIC_SITE_KEYWORDS=impuestos,guinea ecuatorial,declaraciones,servicios fiscales

# ============================================================================
# AUTHENTICATION
# ============================================================================
# JWT secret key for middleware token verification (MUST match backend JWT_SECRET_KEY)
# Server-side only — NOT exposed to browser (no NEXT_PUBLIC_ prefix)
JWT_SECRET_KEY=

# Session timeout (minutes)
NEXT_PUBLIC_SESSION_TIMEOUT=30

# ============================================================================
# PAGINATION & LIMITS
# ============================================================================
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Firebase (for storage/hosting)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=taxasge-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=taxasge-dev.firebasestorage.app

# ============================================================================
# DEVELOPMENT
# ============================================================================
# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# Enable React Query DevTools
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true

# Mock API responses (for testing)
NEXT_PUBLIC_MOCK_API=false

# ============================================================================
# NOTES FOR CLOUD RUN DEPLOYMENT
# ============================================================================
# For Cloud Run, set environment variables via:
# gcloud run deploy taxasge-frontend \
#   --set-env-vars="NEXT_PUBLIC_API_BASE_URL=https://taxasge-backend-prod.run.app"
#
# Or use .env files in Cloud Build:
# - .env.development (for dev deployment)
# - .env.production (for prod deployment)
# ============================================================================
