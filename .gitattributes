# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files
*.py     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.svg    text eol=lf

# Windows-only scripts
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.7z     binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary

# Linguist overrides — exclude vendored / generated from stats
docs/wiki/*.md          linguist-documentation
.github/assets/icons/*  linguist-vendored
*.lock                  linguist-generated
*-lock.json             linguist-generated
